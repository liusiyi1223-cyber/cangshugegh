SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# 微信小程序登录（wx.login 换 openid 用，AppSecret 从微信公众平台「开发设置」获取）
