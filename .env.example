# 复制本文件为 .env 并填写真实值
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cangshuge?schema=public"

# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=""

# 邮件服务（发送注册/登录验证码用，支持任意 SMTP，如 QQ邮箱/163/阿里云邮件推送）
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
